# PowerPulse AI configuration. Copy to .env (same folder as run.py) and fill in what you need.
# Real environment variables override this file. Never commit the real .env.

# ---- App ----
# Public URL used in password-reset links. Use https:// in production (this also turns on Secure cookies).
POWERPULSE_APP_URL=http://127.0.0.1:8000
# SQLite database file (default: data/powerpulse.db)
# POWERPULSE_DB=data/powerpulse.db
# Cookie Secure flag; defaults to on when POWERPULSE_APP_URL starts with https:// (1/0)
# POWERPULSE_SECURE_COOKIES=1
# Session length in days (30 when the user ticks "keep me signed in")
# POWERPULSE_SESSION_DAYS=7
# Background worker: monthly report scheduler + cleanup (1/0)
# POWERPULSE_SCHEDULER=1
# Where run.py listens. Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 only on a trusted network.
# POWERPULSE_HOST=127.0.0.1
# POWERPULSE_PORT=8000
# Comma-separated proxy IPs whose X-Forwarded-For is trusted (needed so rate limits see real client IPs)
# POWERPULSE_TRUSTED_PROXIES=127.0.0.1
# Rate limits per client IP (generous defaults so a shared Wi-Fi / office NAT is not locked out):
# login attempts per 15 minutes, and new accounts per hour. (No inline comments after values in this file.)
# POWERPULSE_LOGIN_LIMIT_PER_IP=100
# POWERPULSE_REGISTER_LIMIT_PER_IP=30
# Hide the interactive API docs at /docs in production
# POWERPULSE_HIDE_API_DOCS=1

# ---- Email (password reset) ----
# Without SMTP the reset link is written to the server log (email test mode), never to the browser.
# Placeholders only - e.g. SMTP_HOST=smtp.example.com, SMTP_USER=alerts@example.com. Put real values in .env, never here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
